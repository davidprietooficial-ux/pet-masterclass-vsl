# Config real de la analítica: lleva la clave de la base y el hash del panel.
# La plantilla (.ejemplo.php) sí va al repo; esta no. En producción vive
# fuera del docroot, pero se ignora aquí también por si alguien la copia.
config-retencion.php
public/api/config-retencion.php
.htpasswd

# Sourcemaps: si alguno se cuela, que no llegue al repositorio
*.map

